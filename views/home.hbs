<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <title>Home</title>
    <style>
        body {
            background-color: rgb(176, 191, 191);
        }

        th {
            min-width: 70px;
            text-align: center;
        }

        th .limitInput {
            max-width: 70px;
            text-align: center;
        }

        /* Chrome, Safari, Edge, Opera */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        #FormSubmit {
            position: sticky;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
        }
    </style>
    <script>
        /* Toast_Alert */
        function toastA(msg, type) {
            const toastAlert = document.getElementById('toastAlert');
            toastAlert.classList = `toast border-0 text-bg-${type}`
            const msgToast = document.getElementById('msgToast');
            msgToast.innerHTML = `${msg}`
            const toast = new bootstrap.Toast(toastAlert);
            toast.show()
            return 'Alert!'
        }
    </script>
</head>

<body>
    <div class="toast-container top-5 start-0 p-4">
        <div class="toast border-0" id="toastAlert">
            <div class="d-flex">
                <div class="toast-body" id="msgToast">
                    /* placeholder */
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <div class="container-fluid p-5 bg-primary text-white text-center">
        <h1>Welcome to Homepage, {{name}}</h1>
        <p>กรุณาเปลี่ยนรหัสผ่านครั้งแรกทุกครั้ง</p>
    </div>

    {{#if message}}
    <div class="container">
        <div class="alert alert-warning alert-dismissible fade show mt-4">
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <strong>{{message}}</strong>
        </div>
    </div>
    {{/if}}

    <div class="container my-4">
        <div class="card">
            <div class="card-body">
                <h1>ACCOUNT : {{ name }}</h1>
                <hr>
                <button type="button" class="btn btn-warning" data-bs-toggle="collapse"
                    data-bs-target="#change-password">เปลี่ยนรหัสผ่าน</button>
                <div id="change-password" class="collapse">
                    <form action="/reset" method="POST" autocomplete="off">
                        <div class="form-floating mb-3 mt-3">
                            <input type="password" class="form-control" id="old-password"
                                placeholder="Enter old Password" name="old_password">
                            <label for="old-password" class="form-label">รหัสผ่านเก่า</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="pwd" placeholder="Enter new password"
                                name="new_password">
                            <label for="pwd" class="form-label">รหัสผ่านใหม่</label>
                        </div>
                        <button type="submit" class="btn btn-success">ยืนยัน</button>
                    </form>
                </div>
                <div class="card-body" style="overflow-y: auto;">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>หมายเลข</th>
                                <th>บน <p style="display: inline;" id="Crd">(Max)</p>
                                </th>
                                <th>โต๊ด <p style="display: inline;" id="Crd">(Max)</p>
                                </th>
                                <th>ล่าง <p style="display: inline;" id="Crd">(Max)</p>
                                </th>
                                <th>วิ่งบน <p style="display: inline;" id="Crd">(Max)</p>
                                </th>
                                <th>วิ่งล่าง <p style="display: inline;" id="Crd">(Max)</p>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="FormInput">
                            <tr>
                                <th><input autocomplete="false" name="number" class="limitInput defInput" type="text"
                                        maxlength="3"></th>
                                <th><input min="0" name="up" type="number" class="limitInput cdInput-0" disabled>
                                </th>
                                <th><input min="0" name="tod" type="number" class="limitInput cdInput-0" disabled>
                                </th>
                                <th><input min="0" name="down" type="number" class="limitInput cdInput-0" disabled>
                                </th>
                                <th><input min="0" name="r_up" type="number" class="limitInput cdInput-0" disabled>
                                </th>
                                <th><input min="0" name="r_down" type="number" class="limitInput cdInput-0" disabled>
                                </th>
                            </tr>
                            <tr>
                                <th><input autocomplete="false" name="number" class="limitInput defInput" type="text"
                                        maxlength="3"></th>
                                <th><input min="0" name="up" type="number" class="limitInput cdInput-1" disabled>
                                </th>
                                <th><input min="0" name="tod" type="number" class="limitInput cdInput-1" disabled>
                                </th>
                                <th><input min="0" name="down" type="number" class="limitInput cdInput-1" disabled>
                                </th>
                                <th><input min="0" name="r_up" type="number" class="limitInput cdInput-1" disabled>
                                </th>
                                <th><input min="0" name="r_down" type="number" class="limitInput cdInput-1" disabled>
                                </th>
                            </tr>
                            <tr>
                                <th><input autocomplete="false" name="number" class="limitInput defInput" type="text"
                                        maxlength="3"></th>
                                <th><input min="0" name="up" type="number" class="limitInput cdInput-2" disabled>
                                </th>
                                <th><input min="0" name="tod" type="number" class="limitInput cdInput-2" disabled>
                                </th>
                                <th><input min="0" name="down" type="number" class="limitInput cdInput-2" disabled>
                                </th>
                                <th><input min="0" name="r_up" type="number" class="limitInput cdInput-2" disabled>
                                </th>
                                <th><input min="0" name="r_down" type="number" class="limitInput cdInput-2" disabled>
                                </th>
                            </tr>
                            <tr>
                                <th><input autocomplete="false" name="number" class="limitInput defInput" type="text"
                                        maxlength="3"></th>
                                <th><input min="0" name="up" type="number" class="limitInput cdInput-3" disabled>
                                </th>
                                <th><input min="0" name="tod" type="number" class="limitInput cdInput-3" disabled>
                                </th>
                                <th><input min="0" name="down" type="number" class="limitInput cdInput-3" disabled>
                                </th>
                                <th><input min="0" name="r_up" type="number" class="limitInput cdInput-3" disabled>
                                </th>
                                <th><input min="0" name="r_down" type="number" class="limitInput cdInput-3" disabled>
                                </th>
                            </tr>
                            <tr>
                                <th><input autocomplete="false" name="number" class="limitInput defInput" type="text"
                                        maxlength="3"></th>
                                <th><input min="0" name="up" type="number" class="limitInput cdInput-4" disabled>
                                </th>
                                <th><input min="0" name="tod" type="number" class="limitInput cdInput-4" disabled>
                                </th>
                                <th><input min="0" name="down" type="number" class="limitInput cdInput-4" disabled>
                                </th>
                                <th><input min="0" name="r_up" type="number" class="limitInput cdInput-4" disabled>
                                </th>
                                <th><input min="0" name="r_down" type="number" class="limitInput cdInput-4" disabled>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <button id="FormSubmit" type="submit" class="btn btn-success my-2">ยืนยันการแทง</button>
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th></th>
                                <th>หมายเลข</th>
                                <th>บน</th>
                                <th>โต๊ด</th>
                                <th>ล่าง</th>
                                <th>วิ่งบน</th>
                                <th>วิ่งล่าง</th>
                            </tr>
                        </thead>
                        <tbody id="dataReload">
                            {{!-- placeholder --}}
                        </tbody>
                    </table>
                </div>
            </div>
            <a href="/logout" class="btn btn-danger">Logout</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="/input_script.js"></script>

    <script>
        document.getElementById('FormSubmit').addEventListener('click', (e) => {
            const dataSet = document.querySelectorAll('#FormInput tr')
            const UseData = [];
            dataSet.forEach((tr) => {
                const inputs = tr.querySelectorAll('input');
                const data = {}
                let counter = 0
                inputs.forEach((input) => {
                    const name = input.name;
                    const value = input.value.trim();
                    if (value) {
                        data[`ID${counter}`] = value;
                        counter++;
                    };
                    input.value = ""
                })
                if (Object.keys(data).length > 0) {
                    UseData.push(data)
                }
            })
            data_add(UseData);
        })

        function data_add(formData) {
            const req = new XMLHttpRequest();
            req.open('POST', '/add');
            req.setRequestHeader('Content-Type', 'application/json');
            req.onload = () => {
                const result = JSON.parse(req.responseText);
                load_data();
                console.log(result);
            }
            req.send(JSON.stringify(formData))
        }

    </script>

</body>

</html>