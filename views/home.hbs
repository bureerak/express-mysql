    <script src="/input_script.js"></script>

    <script>
        document.getElementById('FormSubmit').addEventListener('click', (e) => {
            const dataSet = document.querySelectorAll('#FormInput tr')
            const UseData = [];
            dataSet.forEach((tr) => {
                const inputs = tr.querySelectorAll('input');
                const data = {}
                let counter = 0
                inputs.forEach((input) => {
                    const name = input.name;
                    const value = input.value.trim();
                    if (!input.disabled) {
                        data[`ID${counter}`] = value;
                        counter++;
                    };
                    input.value = ""
                })
                if (Object.keys(data).length > 0 && data.ID0) {
                    UseData.push(data)
                }
            })
            data_add(UseData);
        })

        const modalDetail = document.getElementById('modalSuccess')
        function data_add(formData) {
            const req = new XMLHttpRequest();
            req.open('POST', '/add');
            req.setRequestHeader('Content-Type', 'application/json');
            req.onload = () => {
                const result = JSON.parse(req.responseText);
                load_data();
                // แสดงข้อมูลผลลัพธ์
                modalDetail.innerHTML = ''
                let counter = 0;
                for (num of result) {
                    if (num.type === "success") {
                        const row = document.createElement("tr");
                        row.innerHTML = `<th>${num.num}</th><th>${num.bal1}</th><th>${num.bal2}</th>`;
                        modalDetail.appendChild(row);
                        ++counter;
                    }
                }
                if (counter) { showModal(); }
            }
            req.send(JSON.stringify(formData))
        }

        //send to Check credit
        function creditCheck(num) {
            const input = document.getElementById(`userInput${num}`)
            if (input.value) {
                fetch(`/creditCheck/${input.value}`)
                    .then((res) => res.json())
                    .then((data) => {
                        update_HTML(data)
                    })
                    .catch((err) => console.log(err))
            }
        }
    </script>


