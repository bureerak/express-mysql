        th {
            min-width: 70px;
            text-align: center;
        }

        th .limitInput {
            max-width: 70px;
            text-align: center;
        }

        /* Chrome, Safari, Edge, Opera */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        #FormSubmit {
            position: sticky;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
        }

        .modalContainer {
            position: fixed;
            background-color: rgba(0, 0, 0, 0.5);
            height: 100%;
            width: 100%;
            z-index: 999999;
            display: none;
        }

        .modalContainer.show {
            display: block;
            opacity: 1;
            animation-name: show;
            animation-duration: 0.3s;
        }

        .modalContainer .card {
            overflow-x: auto;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: calc(100% - 12vh);
            text-align: center;
        }

        @keyframes fadeOut {
            0% {
                opacity: 1;
            }

            100% {
                opacity: 0;
            }
        }

        @keyframes fadeIn {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }
    </style>

    <script>
        let countDownDate = 0;

        function counterDisplay() {

            const now = new Date().getTime();
            const distance = countDownDate - now;
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            if (distance < 0) {
                clearInterval(x);
                document.getElementById("demo").innerHTML = "ปิดทำการ";
            } else {
                document.getElementById("demo").innerHTML = days + "D " + hours + "H "
                    + minutes + "M " + seconds + "S ";
            }
        }

        const socket = io(); //socket connect
        socket.on('connect', () => {
            socket.emit("alertJoin", "{{name}}")
        })

        // Update Date
        socket.on('dateUpdate',date => {
            countDownDate = date;
            counterDisplay();
        })

        const x = setInterval(counterDisplay, 1000);
    </script>

    <script>
        /* Toast_Alert */
        function toastA(msg, type) {
            const toastAlert = document.getElementById('toastAlert');
            toastAlert.classList = `toast border-0 text-bg-${type}`
            const msgToast = document.getElementById('msgToast');
            msgToast.innerHTML = `${msg}`
            const toast = new bootstrap.Toast(toastAlert);
            toast.show()
            return 'Alert!'
        }

        function showModal() {
            const modal = document.getElementById("modalContainer");
            const clostBtn = document.getElementById("closeModal");
            modal.style.animationName = "fadeIn";
            modal.classList.add('show');
            clostBtn.addEventListener('click', () => {
                modal.style.animationName = "fadeOut"
                setTimeout(() => {
                    modal.classList.remove('show');
                }, 250)
            }, { once: true });
        }
    </script>
</head>

