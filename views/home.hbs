<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <title>Home</title>
    <style>
        body {
            background-color: rgb(176, 191, 191);
        }
    </style>
</head>

<body>
    <div class="container-fluid p-5 bg-primary text-white text-center" >
        <h1>Welcome to Homepage, {{name}}</h1>
        <p>กรุณาเปลี่ยนรหัสผ่านครั้งแรกทุกครั้ง</p>
    </div>

    {{#if message}}
    <div class="container">
    <div class="alert alert-warning alert-dismissible fade show mt-4">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <strong>{{message}}</strong>
    </div>
    </div>
    {{/if}}

    <div class="container my-4">
        <div class="card">
            <div class="card-body">
                <h1>ACCOUNT : {{ name }}</h1>
                <hr>
                <button type="button" class="btn btn-warning" data-bs-toggle="collapse"
                    data-bs-target="#change-password">เปลี่ยนรหัสผ่าน</button>
                <div id="change-password" class="collapse">

                    <form action="/reset" method="POST">
                        <div class="form-floating mb-3 mt-3">
                            <input type="password" class="form-control" id="old-password"
                                placeholder="Enter old Password" name="old_password">
                            <label for="old-password" class="form-label">รหัสผ่านเก่า</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="pwd" placeholder="Enter new password"
                                name="new_password">
                            <label for="pwd" class="form-label">รหัสผ่านใหม่</label>
                        </div>
                        <button type="submit" class="btn btn-success">ยืนยัน</button>
                    </form>

                </div>
            </div>
            <a href="/logout" class="btn btn-danger">Logout</a>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>